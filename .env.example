# Core runtime
NODE_ENV=development
SITE_ADDRESS=http://localhost
ACME_EMAIL=off
WEB_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
# Safe direct/local default. Compose explicitly overrides this inside the API container.
API_HOST=127.0.0.1
API_PORT=3001

# Data services
POSTGRES_PASSWORD=replace-with-strong-db-password
DATABASE_URL=postgresql://werewolf:replace-with-strong-db-password@postgres:5432/werewolf?schema=public
REDIS_URL=redis://redis:6379
S3_ENDPOINT=http://minio:9000
S3_REGION=auto
S3_BUCKET=werewolf-audio
S3_ACCESS_KEY=minio
S3_SECRET_KEY=change-me
S3_FORCE_PATH_STYLE=true

# Security — replace every value before public deployment
APP_ENCRYPTION_KEY=replace-with-32-byte-base64-key
# Optional comma-separated previous keys during rotation; remove after all records are re-encrypted
APP_ENCRYPTION_KEY_PREVIOUS=
ADMIN_API_KEY=replace-with-at-least-32-random-characters
TRUST_PROXY=1

# Local development only; ignored by the API in production
DEV_INVITE_CODE=MOONLIT-DEV

# Site-wide playable AI providers (never expose these with NEXT_PUBLIC_)
# Local Windows users should prefer 配置AI模型.cmd, which protects keys with
# Windows DPAPI instead of placing plaintext credentials in this file.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6

# Speech transcription is independent from playable AI seats
DASHSCOPE_API_KEY=
DASHSCOPE_ASR_MODEL=

# Cost and abuse controls
AI_DAILY_BUDGET_CENTS=10000
AI_MATCH_BUDGET_CENTS=300
AI_MIN_RESERVATION_CENTS=1
AI_MAX_ATTEMPTS_PER_PROVIDER=2
AI_MATCH_BUDGET_TTL_SECONDS=172800
AI_BUDGET_SETTLEMENT_GRACE_SECONDS=7200
# Optional process-lifetime emergency ceiling; leave blank to rely on Redis daily/match budgets
AI_PROCESS_BUDGET_CENTS=
AI_ESTIMATED_TURN_COST_CENTS=1
AI_PROVIDER_TIMEOUT_MS=20000
AI_FALLBACK_PROVIDER_IDS=
# API waits for the complete provider retry chain plus a 5s queue margin.
# Increase this when fallback providers are configured; production fails fast if it is too small.
AI_QUEUE_CONNECT_TIMEOUT_MS=1500
AI_QUEUE_RESULT_TIMEOUT_MS=
AI_OBSERVER_ROLE_DELAY_MS=650
AI_OBSERVER_NIGHT_DELAY_MS=5000
AI_OBSERVER_VOTE_DELAY_MS=4500
AI_OBSERVER_SPEECH_DELAY_MS=12000
AI_OBSERVER_SUMMARY_READ_MS=2500
AI_TAKEOVER_PROVIDER_ID=deepseek
AI_TAKEOVER_MODEL_ID=deepseek-v4-flash
AI_WORKER_CONCURRENCY=8
TRANSCRIPTION_WORKER_CONCURRENCY=2
PERSISTENCE_WORKER_CONCURRENCY=16

# Optional provider pricing, in cents per one million tokens
AI_PRICE_DEEPSEEK_INPUT_CENTS_PER_MILLION=
AI_PRICE_DEEPSEEK_OUTPUT_CENTS_PER_MILLION=
AI_PRICE_KIMI_INPUT_CENTS_PER_MILLION=
AI_PRICE_KIMI_OUTPUT_CENTS_PER_MILLION=

ROOM_CREATE_RATE_LIMIT=5
TRANSCRIPTION_MAX_SECONDS=60
